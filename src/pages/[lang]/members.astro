---
import Members from "../../components/Members.astro";
import { DEFAULT_LOCALE, LOCALES } from "../../i18n";

export function getStaticPaths() {
  return LOCALES.filter((l) => l.code !== DEFAULT_LOCALE).map((l) => ({
    params: { lang: l.code },
  }));
}
---

<Members code={Astro.params.lang} />
