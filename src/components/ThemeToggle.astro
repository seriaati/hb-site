---
import type { T } from "../i18n";

interface Props {
  t: T;
}

const { t } = Astro.props;
---

<button
  class="theme-toggle grid size-9 cursor-pointer place-items-center rounded-full text-mute transition-colors hover:text-fg"
  type="button"
  aria-label={t("nav.dark_mode")}
  aria-pressed="false"
>
  <svg
    class="size-4 dark:hidden"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"></path>
  </svg>
  <svg
    class="hidden size-4 dark:block"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"
    ></path>
  </svg>
</button>

<script>
  // The <head> applies a saved choice before paint; this keeps it, the button and the browser bar in sync.
  const KEY = "hb-theme";
  const COLORS = { light: "#f1f2f6", dark: "#0f1016" };
  const root = document.documentElement;
  const system = matchMedia("(prefers-color-scheme: dark)");
  const button = document.querySelector<HTMLButtonElement>(".theme-toggle")!;

  const saved = () => root.dataset.theme as "light" | "dark" | undefined;
  const current = () => saved() ?? (system.matches ? "dark" : "light");

  function sync() {
    button.setAttribute("aria-pressed", String(current() === "dark"));
    document
      .querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]')
      .forEach(
        (m) =>
          (m.content =
            COLORS[saved() ?? (m.media.includes("dark") ? "dark" : "light")]),
      );
  }

  button.addEventListener("click", () => {
    const next = current() === "dark" ? "light" : "dark";
    // Choosing what the system already shows drops the override, so the page follows the system again.
    const follow = next === (system.matches ? "dark" : "light");
    if (follow) delete root.dataset.theme;
    else root.dataset.theme = next;
    try {
      if (follow) localStorage.removeItem(KEY);
      else localStorage.setItem(KEY, next);
    } catch {}
    sync();
  });
  system.addEventListener("change", sync);
  sync();
</script>
