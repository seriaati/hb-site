---
// A Discord message from Hoyo Buddy, drawn in Discord's dark theme so replies read as real.
import Mark from "../Mark.astro";
import type { T } from "../../i18n";

interface Props {
  t: T;
  command?: string; // shows the "used /command" line of a slash-command reply
  time?: string;
  class?: string;
}

const { t, command, time = "09:41", class: className } = Astro.props;
const used = t("bot.used", { user: "Traveler" }).split("{command}");
---

<article
  class:list={[
    "dc-msg rounded-2xl bg-[#313338] px-4 pt-3 pb-4 text-left text-[14.5px] leading-[1.375] text-[#dbdee1] shadow-[0_24px_60px_-28px_rgba(0,0,0,.6)]",
    className,
  ]}
>
  {command && (
    <p class="mb-1 flex items-center gap-1.5 pl-[52px] text-[13px] text-[#949ba4]">
      <span class="size-4 rounded-full bg-[#5865f2]/70" aria-hidden="true" />
      <span>
        {used[0]}
        <span class="font-medium text-[#c9cdfb]">{command}</span>
        {used[1]}
      </span>
    </p>
  )}
  <div class="flex gap-3">
    <div class="grid size-10 shrink-0 place-items-center rounded-full bg-[#eef1ff]">
      <Mark class="h-auto w-[60%]" />
    </div>
    <div class="min-w-0 flex-1">
      <p class="flex flex-wrap items-center gap-x-1.5">
        <span class="font-medium text-[#f2f3f5]">Hoyo Buddy</span>
        <span class="rounded-[3px] bg-[#5865f2] px-1 py-px text-[10px] leading-[14px] font-semibold text-white">
          {t("bot.app")}
        </span>
        <span class="text-xs text-[#949ba4]">
          {t("bot.today_at", { time })}
        </span>
      </p>
      <div class="mt-1 grid gap-2">
        <slot />
      </div>
    </div>
  </div>
</article>
