---
import { Image } from "astro:assets";
import Mark from "./Mark.astro";
import LanguagePicker from "./LanguagePicker.astro";
import { LINKS } from "../data/links";
import { getMembers } from "../data/members";
import type { Locale, T } from "../i18n";

interface Props {
  locale: Locale;
  t: T;
}

const { locale, t } = Astro.props;
const links = [
  [LINKS.docs, t("nav.docs")],
  [LINKS.github, "GitHub"],
  [LINKS.discord, t("footer.contact.discord_server")],
  [LINKS.donate, t("footer.sponsor")],
];
const team = await getMembers("team");
---

<footer class="border-t border-line pt-20 pb-10">
  <div class="section-wrap flex flex-col items-center gap-6 text-center">
    <Mark class="h-auto w-12" />
    <p class="font-display text-[clamp(26px,3vw,38px)] font-semibold tracking-[-0.03em]">
      {t("footer.description")}
    </p>
    <a class="btn" href={LINKS.install} target="_blank" rel="noopener">
      {t("hero.cta")}
    </a>
  </div>

  <div class="section-wrap mt-20 grid gap-12 md:grid-cols-[1fr_auto] md:items-end">
    <nav aria-label={t("footer.quick_links.title")}>
      <ul class="flex flex-wrap justify-center gap-x-6 gap-y-3 text-sm md:justify-start">
        {links.map(([href, label]) => (
          <li>
            <a
              href={href}
              target="_blank"
              rel="noopener"
              class="text-mute transition-colors hover:text-fg"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="flex flex-col items-center gap-3 md:items-end">
      <p class="eyebrow">{t("team.title")}</p>
      <ul class="flex flex-wrap justify-center gap-5 md:justify-end">
        {team.map((m) => (
          <li class="flex items-center gap-2.5 text-left">
            <Image
              src={m.avatar_url}
              alt=""
              width={32}
              height={32}
              class="size-8 rounded-full object-cover"
            />
            <span class="grid text-xs leading-tight">
              <span class="text-fg">{m.display_name}</span>
              <span class="text-mute">@{m.username}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="section-wrap mt-12">
    <div class="flex flex-col-reverse items-center justify-between gap-4 border-t border-line pt-6 text-xs text-mute sm:flex-row">
      <p>{t("footer.rights", { year: new Date().getFullYear() })}</p>
      <LanguagePicker locale={locale} t={t} up />
    </div>
  </div>
</footer>
