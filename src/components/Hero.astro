---
import Header from "./Header.astro";
import Mark from "./Mark.astro";
import GameIcon from "./GameIcon.astro";
import { WORLDS } from "../data/worlds";
import { LINKS } from "../data/links";
import type { Locale, T } from "../i18n";

interface Props {
  locale: Locale;
  t: T;
}

const { locale, t } = Astro.props;
const script = ({ "zh-tw": "zh", "zh-cn": "zh", ja: "ja", ko: "ko" } as const)[
  locale.code
];
const angle = (i: number) => -90 + i * (360 / WORLDS.length);
const placeStyle = (w: (typeof WORLDS)[number]) => {
  const font = (script && w.cjk[script]) || w.font;
  const weight = script ? w.cjk.weight : w.weight;
  const tracking = script ? w.cjk.tracking : w.tracking;
  // No CJK face here has an italic; a synthesized slant only smears the strokes.
  const italic = w.italic && !script;
  return `font-family:${font};font-weight:${weight};font-style:${italic ? "italic" : "normal"};text-transform:${w.textCase};letter-spacing:${tracking};font-size:calc(${script ? 0.95 : w.scale} * var(--pmax))`;
};
---

<section id="top" class="world relative isolate overflow-hidden" data-hero>
  <canvas
    class="pointer-events-none absolute inset-0 -z-10 size-full"
    aria-hidden="true"
  ></canvas>
  <div class="section-wrap flex min-h-svh flex-col pt-5 pb-10">
    <Header locale={locale} t={t} />

    <div class="flex flex-1 flex-col items-center justify-center gap-5 pt-6 text-center">
      <div class="stage relative shrink-0" data-stage>
        <svg
          class="absolute inset-0 size-full overflow-visible"
          viewBox="-200 -200 400 400"
          aria-hidden="true"
        >
          <circle
            r="152"
            fill="none"
            stroke="var(--line)"
            stroke-width="1"
          ></circle>
          <path
            class="arc"
            d=""
            fill="none"
            stroke="var(--accent)"
            stroke-width="2"
            stroke-linecap="round"
            opacity="0"
          ></path>
        </svg>
        <button
          class="core"
          type="button"
          aria-label={t("hero.overview")}
          data-core
        >
          <span class="halo" aria-hidden="true"></span>
          <Mark class="h-auto w-[54%]" />
        </button>
        {WORLDS.map((w, i) => (
          <button
            class="emb"
            type="button"
            style={`--a:${angle(i)}deg;--emb-ring:${w.ring}`}
            data-game={w.game}
            aria-pressed="false"
            aria-label={t(`worlds.${w.game}.name`)}
          >
            <span class="face">
              <GameIcon game={w.game} size={52} eager />
            </span>
          </button>
        ))}
      </div>

      <h1 class="w-full">
        <span class="block font-display text-[clamp(20px,2.2vw,28px)] font-normal tracking-[-0.01em] text-mute transition-colors duration-700">
          {t("hero.pre")}
        </span>
        <span class="stack place mt-1 justify-items-center" data-variants>
          <span
            data-v=""
            class="on font-display font-semibold tracking-[-0.035em] text-balance whitespace-normal"
            style="font-size:var(--pmax)"
          >
            {t("hero.all")}
          </span>
          {WORLDS.map((w) => (
            <span data-v={w.game} style={placeStyle(w)} aria-hidden="true">
              {t(`worlds.${w.game}.place`)}
            </span>
          ))}
        </span>
      </h1>

      <p
        class="stack lede max-w-[48ch] justify-items-center text-balance"
        data-variants
      >
        <span data-v="" class="on">
          {t("hero.summary")}
        </span>
        {WORLDS.map((w) => (
          <span data-v={w.game} aria-hidden="true">
            <b class="font-medium text-fg">{t(`worlds.${w.game}.name`)}.</b>{" "}
            {t(`hero.games.${w.game}`)}
          </span>
        ))}
      </p>

      <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-3">
        <a class="btn" href={LINKS.install} target="_blank" rel="noopener">
          {t("hero.cta")}
        </a>
        <span class="text-sm text-mute">{t("hero.cta_note")}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .stage {
    --S: min(340px, 80vw, 40svh);
    width: var(--S);
    height: var(--S);
  }
  .place {
    --pmax: min(7vw, 100px);
    line-height: 1.05;
  }
  .place > span:not([data-v=""]) {
    white-space: nowrap;
  }
  .core {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 30%;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    border-radius: 50%;
    cursor: pointer;
  }
  .halo {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    box-shadow: 0 0 0 1px var(--accent);
    opacity: 0;
  }
  .emb {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 52px;
    height: 52px;
    margin: -26px 0 0 -26px;
    border-radius: 50%;
    cursor: pointer;
    transform: rotate(var(--a)) translate(calc(var(--S) * 0.38))
      rotate(calc(-1 * var(--a)));
  }
  .emb,
  .core {
    z-index: 1;
  }
  /* Crop the publisher strip off the bottom of the bot's game icons. */
  .face :global(img) {
    transform: scale(1.22);
    transform-origin: 50% 30%;
  }
  .face {
    display: block;
    overflow: hidden;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    outline: 1.5px solid transparent;
    outline-offset: 3px;
    transition:
      transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
      outline-color 0.35s,
      filter 0.5s,
      opacity 0.5s;
  }
  /* Hover previews: the emblem lifts and rings in its icon's color. Click commits. */
  @media (hover: hover) {
    .emb:hover .face {
      transform: scale(1.12);
      outline-color: var(--emb-ring);
    }
  }
  .emb:focus-visible {
    outline: none;
  }
  .emb:focus-visible .face {
    outline: 2px solid var(--fg);
  }
  .emb[aria-pressed="true"] .face {
    transform: scale(1.12);
  }
  /* Inside a world the other emblems step back so the chosen one reads as selected. */
  [data-hero].in .emb[aria-pressed="false"] .face {
    filter: saturate(0.4);
    opacity: 0.6;
  }
  [data-hero].in .emb[aria-pressed="false"]:hover .face {
    filter: none;
    opacity: 1;
  }
</style>

<script>
  import { Painter, reducedMotion } from "../scripts/scenes";
  import { WORLD, worldVars, type GameKey } from "../data/worlds";
  import { setGame, onGame } from "../scripts/game";
  import { applyVars, showVariant } from "../scripts/variants";

  const hero = document.querySelector<HTMLElement>("[data-hero]")!;
  const stage = hero.querySelector<HTMLElement>("[data-stage]")!;
  const core = hero.querySelector<HTMLButtonElement>("[data-core]")!;
  const halo = core.querySelector<HTMLElement>(".halo")!;
  const arc = hero.querySelector<SVGPathElement>(".arc")!;
  const embs = [...hero.querySelectorAll<HTMLButtonElement>(".emb")];
  const games = embs.map((b) => b.dataset.game as GameKey);
  const angles = games.map(
    (_, i) => ((-90 + (i * 360) / games.length) * Math.PI) / 180,
  );
  // Bangboos only pop out of TVs that the visible text and controls don't cover.
  const painter = new Painter(hero.querySelector("canvas")!, hero, true, () => [
    ...hero.querySelectorAll(
      "header, [data-stage], h1 > span:first-child, [data-variants] > .on, .btn, .btn + span",
    ),
  ]);
  let current: GameKey | null = null;
  let intro = false;
  let touched = false;

  function arcPath(a: number) {
    const r = 152,
      s = a - 0.34,
      e = a + 0.34;
    return `M ${Math.cos(s) * r} ${Math.sin(s) * r} A ${r} ${r} 0 0 1 ${Math.cos(e) * r} ${Math.sin(e) * r}`;
  }

  function point(game: GameKey | null, opacity: string) {
    if (game) {
      arc.setAttribute("d", arcPath(angles[games.indexOf(game)]));
      arc.setAttribute("opacity", opacity);
    } else arc.setAttribute("opacity", "0");
  }

  function show(game: GameKey | null) {
    current = game;
    hero.classList.toggle("in", !!game);
    applyVars(hero, worldVars(game ? WORLD[game] : null));
    painter.set(game);
    hero
      .querySelectorAll<HTMLElement>("[data-variants]")
      .forEach((el) => showVariant(el, game ?? ""));
    embs.forEach((b, i) =>
      b.setAttribute("aria-pressed", String(games[i] === game)),
    );
    point(game, "1");
  }

  embs.forEach((b, i) => {
    b.addEventListener("click", () => {
      if (intro) return;
      touched = true;
      setGame(current === games[i] ? null : games[i], "hero");
    });
    // Hover only previews: the arc swings toward the emblem, faintly.
    b.addEventListener("pointerenter", (e) => {
      if (!intro && e.pointerType === "mouse" && games[i] !== current)
        point(games[i], "0.4");
    });
    b.addEventListener("pointerleave", () => !intro && point(current, "1"));
  });
  core.addEventListener("click", () => !intro && setGame(null, "hero"));
  onGame((game) => show(game));

  // Opening: the emblems spiral in from the edges, fuse into the mark, then fan out onto the ring.
  async function playIntro() {
    intro = true;
    hero.classList.add("intro");
    const R0 = stage.clientWidth * 0.38;
    const far = Math.max(innerWidth, innerHeight) * 0.62;
    const easeIn = (k: number) => k * k * k;
    const easeOut = (k: number) => 1 - Math.pow(1 - k, 3);
    core.style.opacity = "0";
    let popped = false;
    const start = performance.now();
    await new Promise<void>((done) => {
      const step = (now: number) => {
        const T = now - start;
        embs.forEach((b, i) => {
          if (T < 1600) {
            const k = Math.max(0, Math.min(1, (T - i * 90) / 1050)),
              e = easeIn(k);
            const d = far * (1 - e),
              a = angles[i] + (1 - e) * 1.3;
            b.style.transform = `translate(${Math.cos(a) * d}px, ${Math.sin(a) * d}px) scale(${1.5 - e * 1.1})`;
            b.style.opacity = String(
              Math.min(1, k * 5) * (k > 0.96 ? (1 - k) * 25 : 1),
            );
          } else {
            const k = easeOut(
              Math.max(0, Math.min(1, (T - 1750 - i * 60) / 700)),
            );
            b.style.transform = `translate(${Math.cos(angles[i]) * R0 * k}px, ${Math.sin(angles[i]) * R0 * k}px) scale(${0.4 + 0.6 * k})`;
            b.style.opacity = String(k);
          }
        });
        if (T > 1450 && !popped) {
          popped = true;
          core.style.opacity = "1";
          core.animate(
            [
              { transform: "translate(-50%,-50%) scale(.5)" },
              { transform: "translate(-50%,-50%) scale(1.14)" },
              { transform: "translate(-50%,-50%) scale(1)" },
            ],
            { duration: 650, easing: "cubic-bezier(.2,.8,.2,1)" },
          );
          halo.animate(
            [
              { opacity: 0.9, transform: "scale(.8)" },
              { opacity: 0, transform: "scale(2.2)" },
            ],
            { duration: 900, easing: "ease-out" },
          );
        }
        if (T < 2650) requestAnimationFrame(step);
        else done();
      };
      requestAnimationFrame(step);
    });
    core.style.opacity = "";
    embs.forEach((b) => (b.style.transform = b.style.opacity = ""));
    hero.classList.remove("intro");
    intro = false;
  }

  let seen = false;
  try {
    seen = sessionStorage.getItem("hb-intro") === "1";
    sessionStorage.setItem("hb-intro", "1");
  } catch {}
  // Until the first pick, a ripple runs around the ring now and then to show the emblems are buttons.
  function nudge() {
    if (touched || intro || current || reducedMotion()) return;
    embs.forEach((b, i) =>
      b
        .querySelector(".face")!
        .animate(
          [
            { transform: "scale(1)" },
            { transform: "scale(1.14)", offset: 0.4 },
            { transform: "scale(1)" },
          ],
          { duration: 700, delay: i * 110, easing: "ease-in-out" },
        ),
    );
  }
  let nudges = 0;
  const timer = setInterval(() => {
    if (++nudges > 3 || touched) return clearInterval(timer);
    if (scrollY < innerHeight / 2 && !document.hidden) nudge();
  }, 6000);

  if (!seen && !reducedMotion() && scrollY < innerHeight / 2)
    playIntro().then(() => setTimeout(nudge, 500));
  else setTimeout(nudge, 1200);
</script>
