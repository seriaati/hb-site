---
import { LINKS } from "../data/links";
import type { T } from "../i18n";

interface Props {
  t: T;
}

const { t } = Astro.props;
const facts = ["free", "source", "languages", "servers"] as const;
const link = (href: string, label: string) =>
  `<a href="${href}" target="_blank" rel="noopener">${label}</a>`;
const privacy = t("open.privacy", {
  privacy: link(LINKS.privacy, t("open.privacy_link")),
  security: link(LINKS.security, t("open.security_link")),
});
---

<section id="open-source" class="scroll-mt-6 py-24 sm:py-32">
  <div class="section-wrap flex flex-col items-center gap-4 text-center">
    <p class="eyebrow">{t("open.eyebrow")}</p>
    <h2 class="section-title max-w-[20ch]">{t("open.title")}</h2>
  </div>
  <div class="section-wrap mt-14">
    <dl class="grid grid-cols-2 border-y border-line lg:grid-cols-4">
      {facts.map((f, i) => (
        <div
          class:list={[
            "grid content-start gap-2 px-5 py-8 text-center",
            i % 2 === 1 && "border-l border-line",
            i >= 2 && "border-t border-line lg:border-t-0",
            i === 2 && "lg:border-l",
          ]}
        >
          <dt class="font-display text-[clamp(30px,3.4vw,44px)] leading-none font-semibold tracking-[-0.035em]">
            {t(`open.${f}.value`)}
          </dt>
          <dd class="mx-auto max-w-[24ch] text-sm leading-relaxed text-mute">
            {t(`open.${f}.label`)}
          </dd>
        </div>
      ))}
    </dl>
    <p
      class="prose-links mx-auto mt-10 max-w-[56ch] text-center text-mute"
      set:html={privacy}
    />
    <div class="mt-8 flex justify-center">
      <a
        class="btn-ghost ring-1 ring-line"
        href={LINKS.github}
        target="_blank"
        rel="noopener"
      >
        <svg
          class="size-4"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M12 .7C5.6.7.4 5.9.4 12.3c0 5.1 3.3 9.5 7.9 11 .6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.4 1 .1-.8.4-1.3.8-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.2c0 .3.2.7.8.6a11.6 11.6 0 0 0 7.9-11C23.6 5.9 18.4.7 12 .7z"></path>
        </svg>
        {t("footer.quick_links.github")}
      </a>
    </div>
  </div>
</section>
